{
  "openapi": "3.1.0",
  "info": {
    "title": "Express TypeScript API",
    "version": "1.0.0",
    "description": "API rejestracji, logowania JWT, zarządzania sesją, profilu użytkownika oraz produktów."
  },
  "servers": [
    {
      "url": "https://api.54-36-162-208.sslip.io/api",
      "description": "Serwer API na serwerze"
    },
    {
      "url": "http://{hostname}:8080/api",
      "description": "Lokalny serwer deweloperski",
      "variables": {
        "hostname": {
          "default": "localhost",
          "description": "Hostname API; dla lokalnego uruchomienia pozostaw localhost."
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Authentication",
      "description": "Rejestracja, logowanie i wylogowanie"
    },
    {
      "name": "Profile",
      "description": "Profil zalogowanego użytkownika"
    },
    {
      "name": "Products",
      "description": "Publiczny katalog produktów i administracyjne zarządzanie produktami"
    }
  ],
  "paths": {
    "/products": {
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "listProducts",
        "summary": "Pobiera stronicowaną listę produktów",
        "security": [],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strona produktów.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "post": {
        "tags": [
          "Products"
        ],
        "operationId": "createProduct",
        "summary": "Tworzy produkt",
        "description": "Wymaga tokenu administratora. Data addedAt jest nadawana przez bazę.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              },
              "example": {
                "name": "Kawa ziarnista",
                "description": "Kawa arabica 1 kg",
                "price": 49.99,
                "quantity": 12
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Produkt utworzony.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/products/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "pattern": "^[1-9][0-9]*$"
          }
        }
      ],
      "get": {
        "tags": [
          "Products"
        ],
        "operationId": "getProduct",
        "summary": "Pobiera produkt",
        "security": [],
        "responses": {
          "200": {
            "description": "Produkt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "description": "Nie znaleziono produktu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "put": {
        "tags": [
          "Products"
        ],
        "operationId": "updateProduct",
        "summary": "Aktualizuje produkt",
        "description": "Wymaga tokenu administratora. Należy przesłać wszystkie pola produktu poza addedAt.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Zaktualizowany produkt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductEnvelope"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Nie znaleziono produktu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "delete": {
        "tags": [
          "Products"
        ],
        "operationId": "deleteProduct",
        "summary": "Usuwa produkt",
        "description": "Wymaga tokenu administratora.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Produkt usunięty."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "description": "Nie znaleziono produktu.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "register",
        "summary": "Rejestruje użytkownika",
        "security": [],
        "description": "Hasło jest przechowywane w bazie jako hash bcrypt. Rejestracja nie loguje automatycznie użytkownika.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "email": "user@example.com",
                "password": "BezpieczneHaslo123!",
                "displayName": "Jan Kowalski"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Konto zostało utworzone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "user"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Konto zostało utworzone."
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "409": {
            "description": "Konto z tym adresem e-mail już istnieje.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Konto z tym adresem e-mail już istnieje."
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "login",
        "summary": "Loguje użytkownika",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "email": "user@example.com",
                "password": "BezpieczneHaslo123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Zalogowano. Token JWT należy przesyłać w nagłówku Authorization.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "expiresAt",
                    "refreshToken",
                    "refreshExpiresAt",
                    "user"
                  ],
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "Token JWT podpisany algorytmem HS256."
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Czas wygaśnięcia JWT w UTC."
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "Jednorazowy token do uzyskania nowego zestawu tokenów."
                    },
                    "refreshExpiresAt": {
                      "type": "string",
                      "format": "date-time",
                      "description": "Czas wygaśnięcia refresh tokenu w UTC."
                    },
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Nieprawidłowy adres e-mail lub hasło.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "error": "Nieprawidłowy adres e-mail lub hasło."
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "refresh",
        "summary": "Odświeża tokeny sesji",
        "description": "Wymienia jednorazowy refresh token na nowy JWT i nowy refresh token. Refresh tokeny wygasają po 30 dniach.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokeny zostały odświeżone.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "token",
                    "expiresAt",
                    "refreshToken",
                    "refreshExpiresAt"
                  ],
                  "properties": {
                    "token": {
                      "type": "string",
                      "description": "JWT podpisany algorytmem HS256."
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "refreshToken": {
                      "type": "string",
                      "description": "Nowy jednorazowy refresh token."
                    },
                    "refreshExpiresAt": {
                      "type": "string",
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Refresh token jest nieprawidłowy, wykorzystany lub wygasł.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "logout",
        "summary": "Unieważnia bieżącą sesję",
        "description": "Usuwa sesję z bazy. Token nie będzie akceptowany po wylogowaniu.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Wylogowano pomyślnie.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Wylogowano pomyślnie."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/auth/me": {
      "delete": {
        "tags": [
          "Profile"
        ],
        "operationId": "deleteCurrentUser",
        "summary": "Usuwa konto zalogowanego użytkownika",
        "description": "Wymaga podania aktualnego hasła. Usunięcie konta unieważnia wszystkie powiązane sesje i jest nieodwracalne.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              },
              "example": {
                "password": "BezpieczneHaslo123!"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Konto zostało usunięte.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Konto zostało usunięte."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "description": "Nieprawidłowe hasło lub brak prawidłowej sesji.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "wrongPassword": {
                    "value": {
                      "error": "Nieprawidłowe hasło."
                    }
                  },
                  "unauthorized": {
                    "value": {
                      "error": "Wymagany jest token Bearer."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nie znaleziono użytkownika.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "get": {
        "tags": [
          "Profile"
        ],
        "operationId": "getCurrentUser",
        "summary": "Pobiera profil zalogowanego użytkownika",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Profil użytkownika.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Nie znaleziono użytkownika.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      },
      "patch": {
        "tags": [
          "Profile"
        ],
        "operationId": "updateCurrentUser",
        "summary": "Aktualizuje nazwę wyświetlaną i/lub opis",
        "description": "Prześlij co najmniej jedno z pól displayName lub bio. Nieznane pola, w tym email, są odrzucane. Puste body również zwraca błąd walidacji.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateProfileRequest"
              },
              "examples": {
                "bothFields": {
                  "summary": "Zmiana nazwy i opisu",
                  "value": {
                    "displayName": "Jan Kowalski",
                    "bio": "Lubię podróże i kawę."
                  }
                },
                "bioOnly": {
                  "summary": "Zmiana samego opisu",
                  "value": {
                    "bio": "Lubię podróże i kawę."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Zaktualizowany profil.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "user"
                  ],
                  "properties": {
                    "user": {
                      "$ref": "#/components/schemas/UserProfile"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Nie znaleziono użytkownika.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Token zwrócony przez POST /auth/login."
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "description": "Adres jest przyjmowany bez spacji brzegowych i zapisywany małymi literami."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 72,
            "description": "Od 8 do 72 bajtów UTF-8."
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "refreshToken"
        ],
        "properties": {
          "refreshToken": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "description": "Refresh token otrzymany podczas logowania lub poprzedniego odświeżenia."
          }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "bio": {
            "type": "string",
            "maxLength": 280
          }
        }
      },
      "DeleteAccountRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "password"
        ],
        "properties": {
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 72,
            "description": "Aktualne hasło; maksymalnie 72 bajty UTF-8."
          }
        }
      },
      "ProductInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "price",
          "quantity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 99999999.99,
            "multipleOf": 0.01
          },
          "quantity": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        }
      },
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "price",
          "addedAt",
          "quantity"
        ],
        "properties": {
          "id": {
            "type": "string",
            "example": "1"
          },
          "name": {
            "type": "string",
            "example": "Kawa ziarnista"
          },
          "description": {
            "type": "string",
            "example": "Kawa arabica 1 kg"
          },
          "price": {
            "type": "number",
            "example": 49.99
          },
          "addedAt": {
            "type": "string",
            "format": "date-time",
            "readOnly": true
          },
          "quantity": {
            "type": "integer",
            "example": 12
          }
        }
      },
      "ProductEnvelope": {
        "type": "object",
        "required": [
          "item"
        ],
        "properties": {
          "item": {
            "$ref": "#/components/schemas/Product"
          }
        }
      },
      "ProductPage": {
        "type": "object",
        "required": [
          "items",
          "page",
          "limit",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "page": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "required": [
          "id",
          "email",
          "displayName",
          "bio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Identyfikator użytkownika zwracany jako tekst.",
            "example": "42"
          },
          "email": {
            "type": "string",
            "format": "email",
            "readOnly": true,
            "example": "user@example.com"
          },
          "displayName": {
            "type": "string",
            "maxLength": 80,
            "example": "Jan Kowalski"
          },
          "bio": {
            "type": "string",
            "maxLength": 280,
            "example": "Lubię podróże i kawę."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ValidationError": {
        "description": "Błąd walidacji zawiera details; niepoprawny JSON zwraca tylko error.",
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "example": "Nieprawidłowe dane."
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "field",
                "message"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "description": "Ścieżka błędnego pola; pusty tekst oznacza błąd całego body."
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Błędne dane wejściowe lub niepoprawny JSON.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "examples": {
              "invalidFields": {
                "value": {
                  "error": "Nieprawidłowe dane.",
                  "details": [
                    {
                      "field": "email",
                      "message": "Podaj poprawny adres e-mail."
                    }
                  ]
                }
              },
              "malformedJson": {
                "value": {
                  "error": "Nieprawidłowy format JSON."
                }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Brak, niepoprawny, wygasły lub unieważniony token Bearer.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "examples": {
              "missingToken": {
                "value": {
                  "error": "Wymagany jest token Bearer."
                }
              },
              "invalidToken": {
                "value": {
                  "error": "Token jest nieprawidłowy lub wygasł."
                }
              },
              "revokedSession": {
                "value": {
                  "error": "Sesja wygasła lub została wylogowana."
                }
              }
            }
          }
        }
      },
      "Forbidden": {
        "description": "Użytkownik nie ma uprawnień administratora.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Brak wymaganych uprawnień."
            }
          }
        }
      },
      "ServerError": {
        "description": "Nieoczekiwany błąd serwera, np. problem z bazą danych.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            },
            "example": {
              "error": "Wystąpił nieoczekiwany błąd serwera."
            }
          }
        }
      }
    }
  }
}
